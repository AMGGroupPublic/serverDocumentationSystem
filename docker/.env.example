# Copy to docker/.env and adjust to your host user.
# Pick up your values with:  id -u  /  id -g
SERVERDOCS_UID=1000
SERVERDOCS_GID=1000

# Optional: forward the host's unlocked ssh-agent into the container so hosts
# whose key lives only in the agent authenticate alongside the /keys mount.
# Leave unset (comment out) for keyfile-only auth. The agent socket is owned
# by your host user, so SERVERDOCS_UID/GID above must match `id -u`/`id -g`.
# Usually inherited from your shell; set explicitly only to override:
#SSH_AUTH_SOCK=/run/user/1000/keyring/ssh
